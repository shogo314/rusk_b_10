// verification-helper: PROBLEM https://onlinejudge.u-aizu.ac.jp/problems/ITP1_8_B
while let Some(text) = try_read::<Str>() {
    match text {
        "0" => {
            break;
        }
        digits => {
            let sum := 0;
            for i in 0 .. digits.len() {
                sum += Int(digits[i]) - Int('0');
            }
            wt sum;
        }
    }
}
