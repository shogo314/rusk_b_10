// verification-helper: PROBLEM https://onlinejudge.u-aizu.ac.jp/problems/ITP1_4_D
// Source: https://judge.u-aizu.ac.jp/onlinejudge/description.jsp?id=ITP1_4_D
in n: Int;
in values(n): Vec<Int>;
let result := fold(
    values,
    (1000000000000000000, -1000000000000000000, 0),
    (acc: (Int, Int, Int), x: Int) => (min(acc[0], x), max(acc[1], x), acc[2] + x)
);
wt result;
