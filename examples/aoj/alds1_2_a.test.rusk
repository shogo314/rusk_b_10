// verification-helper: PROBLEM https://onlinejudge.u-aizu.ac.jp/problems/ALDS1_2_A
// ALDS1_2_A - Bubble Sort
// https://onlinejudge.u-aizu.ac.jp/problems/ALDS1_2_A
// 隣接要素の交換
in n: Int;
in a(n): Vec<Int>;
let swaps := 0;
let changed := true;
while changed {
    changed = false;
    let j := n - 1;
    while j > 0 {
        if a[j] < a[j - 1] {
            let held := a[j];
            a[j] := a[j - 1];
            a[j - 1] := held;
            swaps += 1;
            changed = true;
        }
        j -= 1;
    }
}
wt a;
wt swaps;
