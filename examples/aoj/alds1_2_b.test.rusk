// verification-helper: PROBLEM https://onlinejudge.u-aizu.ac.jp/problems/ALDS1_2_B
// ALDS1_2_B - Selection Sort
// https://onlinejudge.u-aizu.ac.jp/problems/ALDS1_2_B
// 要素の交換
in n: Int;
in a(n): Vec<Int>;
let swaps := 0;
for i in 0 .. n {
    let smallest = i;
    for j in i .. n {
        if a[j] < a[smallest] {
            smallest := j;
        }
    }
    if smallest != i {
        let held := a[i];
        a[i] := a[smallest];
        a[smallest] := held;
        swaps += 1;
    }
}
wt a;
wt swaps;
