// verification-helper: PROBLEM https://onlinejudge.u-aizu.ac.jp/problems/ITP1_7_C
// ITP1_7_C - Spreadsheet
// https://onlinejudge.u-aizu.ac.jp/problems/ITP1_7_C
// 行列の集計
in r, c: Int;
let totals := [0; c + 1];
for i in 0 .. r {
    in row(c): Vec<Int>;
    row.push_back(row.sum());
    for j in 0 .. (c + 1) {
        totals[j] += row[j];
    }
    wt row;
}
wt totals;
