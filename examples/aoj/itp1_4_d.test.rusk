// verification-helper: PROBLEM https://onlinejudge.u-aizu.ac.jp/problems/ITP1_4_D
// ITP1_4_D - Min, Max and Sum
// https://onlinejudge.u-aizu.ac.jp/problems/ITP1_4_D
// 集計
in n: Int;
in values(n): Vec<Int>;
let low = values[0];
let high = values[0];
for value in values {
    low = min(low, value);
    high = max(high, value);
}
wt low, high, values.sum();
