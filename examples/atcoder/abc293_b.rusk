// B - Call the ID Number
// https://atcoder.jp/contests/abc293/tasks/abc293_b
in n: Int;
in a(n): Vec<Int>;
let called := [false; n];
for i in 0 .. n {
    if !called[i] {
        called[a[i] - 1] = true;
    }
}
let answer: Vec<Int> := [];
for i in 0 .. n {
    if !called[i] {
        answer.push_back(i + 1);
    }
}
wt answer.len();
wt answer;
