// C - Collinearity
// https://atcoder.jp/contests/abc181/tasks/abc181_c
// 外積と全探索
in n: Int;
let points: Vec<Vec<Int>> := [];
for i in 0 .. n {
    in point(2): Vec<Int>;
    points.push_back(point);
}
let found := false;
for i in 0 .. n {
    for j in (i + 1) .. n {
        for k in (j + 1) .. n {
            if (points[j][0] - points[i][0]) * (points[k][1] - points[i][1]) == (
                points[j][1] - points[i][1]
            ) * (points[k][0] - points[i][0]) {
                found = true;
            }
        }
    }
}
wt found;
