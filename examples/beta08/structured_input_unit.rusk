// Unit input can return a shared object whose cleanup follows the containing Tuple.
extern symbol input_state {
    code: "Obj<std::int64_t> input_cleanup;",
}
extern fn watch(n: Int) {
    cpp_name: "watch_input_cleanup",
    code: "void watch_input_cleanup(Obj<std::int64_t> n,Loc){input_cleanup=n;}",
}
extern fn __read__() -> Unit {
    return_abi: "object",
    cpp_name: "reader::unit",
    code: "namespace reader {Obj<Unit> unit(Loc){return Obj<Unit>(new Unit{},[](Unit* p){++*input_cleanup;delete p;});}}",
}
let count := 0;
watch(count);
{
    in pair: (Unit, Int), rows(2): Vec<(Unit, Int)>;
    wt pair[1], rows[0][1], rows[1][1], count;
}
wt count;
