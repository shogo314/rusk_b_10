extern type Leaf {
    cpp_name: "std::int64_t",
}
enum Choice {
    Pair(Leaf, Int),
    Empty
}
extern symbol observation {
    code: "std::function<void()> clear_source;std::int64_t dropped=0,during=-1;",
}
extern fn leaf() -> Leaf {
    cpp_name: "leaf",
    code: "Obj<std::int64_t> leaf(Loc){return make_obj<std::int64_t>(4);}",
}
extern fn wrap<T>(x: T) -> T {
    code: "Obj<@{T}> @{fn}(Obj<@{T}> x,Loc){return Obj<@{T}>(new @{T}(*x),[](auto* p){++dropped;delete p;});}",
}
extern fn watch<T>(a: Vec<T>) {
    code: "void @{fn}(Obj<@{Vec<T>}> a,Loc){clear_source=[a](){a->clear();++a->version;};}",
}
extern fn clear_watch() {
    cpp_name: "clear_watch",
    code: "void clear_watch(Loc){clear_source={};}",
}
extern fn copy(x: Leaf) -> Leaf {
    cpp_name: "copy_leaf",
    code: "Obj<std::int64_t> copy_leaf(Obj<std::int64_t> x,Loc){if(clear_source)clear_source();during=dropped;return make_obj<std::int64_t>(*x);}",
}
extern fn first_copy<T>(a: Vec<T>) -> T {
    code: "Obj<@{T}> @{fn}(Obj<@{Vec<T>}> a,Loc loc){auto held=(*a)[0];return @{rooted_call copy(T)->T}(held,loc);}",
}
extern fn counts() -> (Int, Int) {
    cpp_name: "counts",
    code: "Obj<RuskRecord0> counts(Loc){return make_obj<RuskRecord0>(RuskRecord0{make_obj<std::int64_t>(during),make_obj<std::int64_t>(dropped)});}",
}
let rows := [wrap(Choice::Pair(leaf(), 7))];
watch(rows);
let copied := first_copy(rows);
clear_watch();
wt counts(), rows.len(), match copied {
    Pair(x, n) => n,
    Empty => 0,
};
