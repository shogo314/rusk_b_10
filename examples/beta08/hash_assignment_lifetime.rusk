extern type Leaf {
    cpp_name: "std::int64_t",
}
extern symbol hash_assignment_state {
    code: "std::function<void()> observe_displaced_value;",
}
extern fn watch<K, V>(owner: Dict<K, V>, seen: Int, mutate: Bool) {
    code: "void @{fn}(Obj<@{Dict<K,V>}> owner,Obj<@{Int}> seen,Obj<@{Bool}> mutate,Loc){observe_displaced_value=[owner,seen,mutate](){*seen=static_cast<std::int64_t>(owner->entries.size());if(*mutate){owner->entries.clear();++owner->version;}};}",
}
