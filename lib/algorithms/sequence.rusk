//! 走査できる値の判定・配列化・累積処理です。

/// すべての要素が述語を満たすか調べます。偽で短絡し、空なら真です。
extern fn all<S, F, I, T>(source: S, predicate: F) -> Bool {
    code: "Obj<@{Bool}> @{fn}(Obj<@{S}> source,Obj<@{F}> predicate,Loc loc){auto it=@{call __iter__(S)->I}(source,loc);while(*@{call __iter_has_next__(I)->Bool}(it,loc)){auto value=@{call __iter_next__(I)->T}(it,loc);auto accepted=@{invoke F(T)->Bool}(predicate,value,loc);rusk_guard_iter(it,loc);if(*accepted==false)return make_obj<@{Bool}>(false);}return make_obj<@{Bool}>(true);}",
}

/// 述語を満たす要素があるか調べます。真で短絡し、空なら偽です。
extern fn any<S, F, I, T>(source: S, predicate: F) -> Bool {
    code: "Obj<@{Bool}> @{fn}(Obj<@{S}> source,Obj<@{F}> predicate,Loc loc){auto it=@{call __iter__(S)->I}(source,loc);while(*@{call __iter_has_next__(I)->Bool}(it,loc)){auto value=@{call __iter_next__(I)->T}(it,loc);auto accepted=@{invoke F(T)->Bool}(predicate,value,loc);rusk_guard_iter(it,loc);if(*accepted==true)return make_obj<@{Bool}>(true);}return make_obj<@{Bool}>(false);}",
}

/// 走査順に要素を格納した配列を返します。配列の要素は走査から受け取った値を共有します。
extern fn to_vec<S, I, T>(source: S) -> Vec<T> {
    code: "Obj<@{Vec<T>}> @{fn}(Obj<@{S}> source,Loc loc){auto it=@{call __iter__(S)->I}(source,loc);auto result=make_obj<@{Vec<T>}>(@{Vec<T>}{ });while(*@{call __iter_has_next__(I)->Bool}(it,loc)){auto value=@{call __iter_next__(I)->T}(it,loc);result->push_back(value);}return result;}",
}
/// 初期値をコピーし、走査順に累積値を更新して最後の値を返します。
extern fn fold<S, A, F, I, T>(source: S, seed: A, callback: F) -> A {
    code: "@{return A} @{fn}(Obj<@{S}> source,Obj<@{A}> seed,Obj<@{F}> callback,Loc loc){auto it=@{call __iter__(S)->I}(source,loc);auto accumulator=@{boxed_call copy(A)->A}(seed,loc);while(*@{call __iter_has_next__(I)->Bool}(it,loc)){auto value=@{call __iter_next__(I)->T}(it,loc);accumulator=@{boxed_invoke F(A,T)->A}(callback,accumulator,value,loc);rusk_guard_iter(it,loc);}@{if_type A matches Unit}return;@{else}return accumulator;@{end}}",
}
/// 初期値と各更新後の累積値を、それぞれコピーして配列に格納します。
extern fn scan<S, A, F, I, T>(source: S, seed: A, callback: F) -> Vec<A> {
    code: "Obj<@{Vec<A>}> @{fn}(Obj<@{S}> source,Obj<@{A}> seed,Obj<@{F}> callback,Loc loc){auto it=@{call __iter__(S)->I}(source,loc);auto result=make_obj<@{Vec<A>}>(@{Vec<A>}{ });auto accumulator=@{boxed_call copy(A)->A}(seed,loc);result->push_back(@{boxed_call copy(A)->A}(accumulator,loc));while(*@{call __iter_has_next__(I)->Bool}(it,loc)){auto value=@{call __iter_next__(I)->T}(it,loc);accumulator=@{boxed_invoke F(A,T)->A}(callback,accumulator,value,loc);rusk_guard_iter(it,loc);result->push_back(@{boxed_call copy(A)->A}(accumulator,loc));}return result;}",
}
