//! 単調な述語の境界探索です。

// Algorithms use the same generic extern and callback references as user code.
/// 半開区間 `[left, right)` で述語が最初に真になる位置を二分探索します。述語は偽から真へ単調に変化する必要があります。すべて偽なら `right` を返します。
///
/// ```rusk
/// wt first_true(0, 10, (i: Int) => i >= 4);
/// ```
///
/// 出力
///
/// ```text
/// 4
/// ```
extern fn first_true<F>(left: Int, right: Int, predicate: F) -> Int {
    code: "Obj<@{Int}> @{fn}(Obj<@{Int}> left,Obj<@{Int}> right,Obj<@{F}> predicate,Loc loc){auto l=*left,r=*right;if(l>r)fail(loc,\"invalid binary search interval\");while(l<r){auto mid=static_cast<std::int64_t>(static_cast<__int128>(l)+(static_cast<__int128>(r)-l)/2);bool yes=*@{invoke F(Int)->Bool}(predicate,make_obj<@{Int}>(mid),loc);if(yes)r=mid;else l=mid+1;}return make_obj<@{Int}>(l);}",
}
