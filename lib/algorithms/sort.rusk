//! 比較関数やキーを使う配列の整列です。

/// 比較関数で配列を安定ソートします。比較関数には厳密弱順序を与えます。
extern fn sort_by_comp<T, F>(source: Vec<T>, callback: F) {
    code: "void @{fn}(Obj<@{Vec<T>}> source,Obj<@{F}> callback,Loc loc){auto version=source->version;auto values=*source;std::stable_sort(values.begin(),values.end(),[&](const auto& a,const auto& b){if(source->version!=version)fail(loc,\"container changed during callback\");auto result=@{invoke F(T,T)->Bool}(callback,a,b,loc);if(source->version!=version)fail(loc,\"container changed during callback\");return *result;});source->assign(values.begin(),values.end());++source->version;}",
}

/// 各要素のキーを1回ずつ計算してコピーし、キーの全順序 `<=>` で配列を安定ソートします。
extern fn sort_by_key<T, F, K>(source: Vec<T>, callback: F) {
    code: "void @{fn}(Obj<@{Vec<T>}> source,Obj<@{F}> callback,Loc loc){auto version=source->version;constexpr bool may_change=@{writes_invoke F(T)->K}||@{writes copy(K)->K}||@{writes __total_less__<K>(K,K)->Bool};std::vector<std::pair<Obj<@{K}>,Obj<@{T}>>> values;values.reserve(source->size());for(std::size_t i=0,n=source->size();i<n;++i){if constexpr(may_change){if(source->version!=version)fail(loc,\"container changed during callback\");}auto value=(*source)[i];auto key=@{invoke F(T)->K}(callback,value,loc);if constexpr(may_change){if(source->version!=version)fail(loc,\"container changed during callback\");}auto detached=@{call copy(K)->K}(key,loc);if constexpr(@{writes copy(K)->K}){if constexpr(may_change){if(source->version!=version)fail(loc,\"container changed during callback\");}}values.push_back({std::move(detached),value});}if constexpr(may_change){if(source->version!=version)fail(loc,\"container changed during callback\");}if constexpr(!may_change && !@{fails __total_less__<K>(K,K)->Bool}){std::stable_sort(values.begin(),values.end(),[](const auto& a,const auto& b){return @{value_call __total_less__<K>(K,K)->Bool}(a.first,b.first,Loc{});});}else{std::stable_sort(values.begin(),values.end(),[&](const auto& a,const auto& b){if constexpr(@{writes __total_less__<K>(K,K)->Bool}){if constexpr(may_change){if(source->version!=version)fail(loc,\"container changed during callback\");}}auto result=@{value_call __total_less__<K>(K,K)->Bool}(a.first,b.first,loc);if constexpr(@{writes __total_less__<K>(K,K)->Bool}){if constexpr(may_change){if(source->version!=version)fail(loc,\"container changed during callback\");}}return result;});}for(std::size_t i=0;i<values.size();++i){if constexpr(may_change){if(source->version!=version)fail(loc,\"container changed during callback\");}(*source)[i]=values[i].second;}if constexpr(may_change){if(source->version!=version)fail(loc,\"container changed during callback\");}++source->version;}",
}
