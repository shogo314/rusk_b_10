//! 可変長配列と配列の走査操作です。

// Ordinary generic extern declarations for vector types and operations.
/// 要素を順番に保持する可変長配列です。
extern type<T> Vec {
    cpp_name: "RuskVec<{T}>",
    representation: "vector<T>",
}
/// 配列を共有して現在の走査位置を保持します。走査中の構造変更は実行時エラーです。
extern type<T> Iter<Vec<T>> {
    cpp_name: "RuskIter<{T}>",
    representation: "iterator<T>",
    retains: "owner:Vec<T>",
}

extern fn __write__<T>(a: Vec<T>) {
    effects: "checked_io_write",
    lower: "([&](){auto emit=[&](const auto& a){[[maybe_unused]]const auto version=a->version;const auto size=a->size();auto guard=[&](){if constexpr(@{writes __write__(T)->Unit}){if(a->version!=version||a->size()!=size)fail($loc,\"container changed during output\");}};for(std::size_t i=0;i<size;++i){guard();if(i)rusk_write(' ');if constexpr(@{writes __write__(T)->Unit}){{auto item=(*a)[i];@{value_call __write__(T)->Unit}(item,$loc);guard();}}else{@{value_call __write__(T)->Unit}((*a)[i],$loc);}guard();}};if constexpr(@{writes __write__(T)->Unit}){auto owner=$0;emit(owner);}else emit($0);}())",
    code: "void @{fn}(Obj<@{Vec<T>}> a,Loc loc){([&](){auto emit=[&](const auto& a){[[maybe_unused]]const auto version=a->version;const auto size=a->size();auto guard=[&](){if constexpr(@{writes __write__(T)->Unit}){if(a->version!=version||a->size()!=size)fail(loc,\"container changed during output\");}};for(std::size_t i=0;i<size;++i){guard();if(i)rusk_write(' ');if constexpr(@{writes __write__(T)->Unit}){{auto item=(*a)[i];@{value_call __write__(T)->Unit}(item,loc);guard();}}else{@{value_call __write__(T)->Unit}((*a)[i],loc);}guard();}};if constexpr(@{writes __write__(T)->Unit}){auto owner=a;emit(owner);}else emit(a);}());}",
}

extern fn __read__<T>(count: Int) -> Vec<T> {
    code: "Obj<@{Vec<T>}> @{fn}(Obj<@{Int}> count,Loc loc){const auto size=*count;if(size<0)fail(loc,\"negative array length\");auto result=make_obj<@{Vec<T>}>(@{Vec<T>}{ });if(static_cast<__int128>(size)>static_cast<__int128>(result->max_size()))fail(loc,\"array length out of range\");result->reserve(static_cast<std::size_t>(size));for(std::int64_t i=0;i<size;++i)result->push_back(@{boxed_call __read__()->T}(loc));return result;}",
}

extern fn __vec_new__<T>() -> Vec<T> {
    effects: "read_fresh",
    code: "Obj<@{Vec<T>}> @{fn}([[maybe_unused]] Loc loc) { return make_obj<@{Vec<T>}>(@{Vec<T>}{}); }",
}

extern fn __vec_repeat__<T>(initial: T, count: Int) -> Vec<T> {
    effects: "checked_read_fresh",
    code: "Obj<@{Vec<T>}> @{fn}(Obj<@{T}> initial, Obj<std::int64_t> count, [[maybe_unused]] Loc loc) { if(*count<0) fail(loc,\"negative array length\"); auto a=make_obj<@{Vec<T>}>(@{Vec<T>}{}); if(static_cast<__int128>(*count)>static_cast<__int128>(a->max_size())) fail(loc,\"array length out of range\"); a->reserve(static_cast<std::size_t>(*count)); for(std::int64_t i=0;i<*count;++i) a->push_back(@{owned_call copy(T)->T}(initial,loc)); return a; }",
}

/// 配列の要素数を返します。
extern fn len<T>(a: Vec<T>) -> Int {
    lower: "checked_int(static_cast<__int128>($0->size()), $loc)",
    effects: "checked_read_fresh",
    code: "Obj<std::int64_t> @{fn}(Obj<@{Vec<T>}> a, [[maybe_unused]] Loc loc) { return make_obj<std::int64_t>(checked_int(static_cast<__int128>(a->size()),loc)); }",
}

/// 値を共有したまま配列の末尾に追加します。
extern fn push_back<T>(a: Vec<T>, x: T) {
    effects: "resize_retain_second",
    code: "void @{fn}(Obj<@{Vec<T>}> a, Obj<@{T}> x, [[maybe_unused]] Loc loc) { a->push_back(x); ++a->version; }",
}

extern fn __getitem__<T>(a: Vec<T>, i: Int) -> T {
    return_abi: "object",
    lower_owned: "(*$0)[checked_index($0->size(),*$1,$loc)]",
    lower_borrowed: "(*$0)[checked_index($0->size(),*$1,$loc)]",
    effects: "element",
    code: "Obj<@{T}> @{fn}(Obj<@{Vec<T>}> a, Obj<std::int64_t> i, [[maybe_unused]] Loc loc) { return (*a)[checked_index(a->size(),*i,loc)]; }",
}

extern fn __setitem__<T>(a: Vec<T>, i: Int, x: T) -> T {
    return_abi: "object",
    effects: "replace_element",
    code: "Obj<@{T}> @{fn}(Obj<@{Vec<T>}> a, Obj<std::int64_t> i, Obj<@{T}> x, [[maybe_unused]] Loc loc) { (*a)[checked_index(a->size(),*i,loc)]=x; return x; }",
}

/// 各要素をその型の `copy` でコピーし、新しい配列を返します。
extern fn copy<T>(a: Vec<T>) -> Vec<T> {
    effects: "checked_read_fresh",
    lower_owned: "([&](){auto clone=[&](const auto& input){const auto size=input->size();[[maybe_unused]]const auto version=input->version;auto guard=[&](){if constexpr(@{writes copy(T)->T}){if(input->version!=version||input->size()!=size)fail($loc,\"container changed during copy\");}};auto result=make_obj<@{Vec<T>}>(@{Vec<T>}{});result->reserve(size);for(std::size_t i=0;i<size;++i){guard();if constexpr(@{writes copy(T)->T}){{auto item=(*input)[i];result->push_back(@{owned_call copy(T)->T}(item,$loc));guard();}}else result->push_back(@{owned_call copy(T)->T}((*input)[i],$loc));guard();}return result;};if constexpr(@{writes copy(T)->T}){auto owner=$0;return clone(owner);}else return clone($0);}())",
    code: "Obj<@{Vec<T>}> @{fn}(Obj<@{Vec<T>}> a,Loc loc){return ([&](){auto clone=[&](const auto& input){const auto size=input->size();[[maybe_unused]]const auto version=input->version;auto guard=[&](){if constexpr(@{writes copy(T)->T}){if(input->version!=version||input->size()!=size)fail(loc,\"container changed during copy\");}};auto result=make_obj<@{Vec<T>}>(@{Vec<T>}{});result->reserve(size);for(std::size_t i=0;i<size;++i){guard();if constexpr(@{writes copy(T)->T}){{auto item=(*input)[i];result->push_back(@{owned_call copy(T)->T}(item,loc));guard();}}else result->push_back(@{owned_call copy(T)->T}((*input)[i],loc));guard();}return result;};if constexpr(@{writes copy(T)->T}){auto owner=a;return clone(owner);}else return clone(a);}());}",
}

extern fn __assign__<T>(a: Vec<T>, b: Vec<T>) {
    effects: "checked_resize_first",
    code: "void @{fn}(Obj<@{Vec<T>}> a,Obj<@{Vec<T>}> b,Loc loc){auto snapshot=@{owned_call copy(Vec<T>)->Vec<T>}(b,loc);const auto size=snapshot->size();a->swap(*snapshot);++a->version;const auto version=a->version;auto guard=[&](){if(a->version!=version||a->size()!=size)fail(loc,\"container changed during assignment\");};snapshot->clear();guard();if(snapshot->capacity()>=size){for(auto& item:*a)snapshot->push_back(std::move(item));a->clear();a->swap(*snapshot);}snapshot.reset();guard();}",
}

extern fn __bool__<T>(a: Vec<T>) -> Bool {
    lower: "!$0->empty()",
    effects: "read_fresh",
    code: "Obj<bool> @{fn}(Obj<@{Vec<T>}> a, [[maybe_unused]] Loc loc) { return make_obj<bool>(!a->empty()); }",
}

/// 配列の要素の並び順をその場で逆にします。
extern fn reverse<T>(a: Vec<T>) {
    code: "void @{fn}(Obj<@{Vec<T>}> a, [[maybe_unused]] Loc loc) { std::reverse(a->begin(),a->end()); ++a->version; }",
}

extern fn __add__<T>(a: Vec<T>, b: Vec<T>) -> Vec<T> {
    code: "Obj<@{Vec<T>}> @{fn}(Obj<@{Vec<T>}> a, Obj<@{Vec<T>}> b, [[maybe_unused]] Loc loc) { auto result=make_obj<@{Vec<T>}>(*a); result->insert(result->end(),b->begin(),b->end()); return result; }",
}

extern fn __iadd__<T>(a: Vec<T>, b: Vec<T>) {
    code: "void @{fn}(Obj<@{Vec<T>}> a, Obj<@{Vec<T>}> b, [[maybe_unused]] Loc loc) { auto snapshot=*b; a->insert(a->end(),snapshot.begin(),snapshot.end()); ++a->version; }",
}

extern fn __iter__<T>(a: Vec<T>) -> Iter<Vec<T>> {
    effects: "read_fresh",
    aliases: "return.owner=0",
    code: "Obj<@{Iter<Vec<T>>}> @{fn}(Obj<@{Vec<T>}> a, [[maybe_unused]] Loc loc) { return make_obj<@{Iter<Vec<T>>}>(@{Iter<Vec<T>>}{a,0,a->version}); }",
}

// Iterator copies preserve position and share the owner, regardless of T.
/// 現在の走査位置をコピーし、配列を共有する別の走査状態を返します。
extern fn copy<T>(it: Iter<Vec<T>>) -> Iter<Vec<T>> {
    effects: "read_fresh",
    aliases: "return.owner=0.owner",
    lower_owned: "make_obj<@{Iter<Vec<T>>}>(*$0)",
    code: "Obj<@{Iter<Vec<T>>}> @{fn}(Obj<@{Iter<Vec<T>>}> it, [[maybe_unused]] Loc loc) { return make_obj<@{Iter<Vec<T>>}>(*it); }",
}

extern fn __iter_has_next__<T>(it: Iter<Vec<T>>) -> Bool {
    lower: "(check_iter($0,$loc), $0->index < $0->owner->size())",
    code: "Obj<bool> @{fn}(Obj<@{Iter<Vec<T>>}> it, [[maybe_unused]] Loc loc) { check_iter(it,loc); return make_obj<bool>(it->index<it->owner->size()); }",
}

extern fn __iter_next__<T>(it: Iter<Vec<T>>) -> T {
    return_abi: "object",
    lower_owned: "([&](){check_iter($0,$loc);if($0->index>=$0->owner->size())fail($loc,\"iterator exhausted\");return (*$0->owner)[$0->index++];}())",
    lower_borrowed: "([&]() -> const auto&{check_iter($0,$loc);if($0->index>=$0->owner->size())fail($loc,\"iterator exhausted\");return (*$0->owner)[$0->index++];}())",
    code: "Obj<@{T}> @{fn}(Obj<@{Iter<Vec<T>>}> it, [[maybe_unused]] Loc loc) { check_iter(it,loc); if(it->index>=it->owner->size()) fail(loc,\"iterator exhausted\"); return (*it->owner)[it->index++]; }",
}

extern fn __not__<T>(a: Vec<T>) -> Bool {
    lower: "!(!$0->empty())",
    effects: "read_fresh",
    code: "Obj<bool> @{fn}(Obj<@{Vec<T>}> a, Loc) { return make_obj<bool>(a->empty()); }",
}

/// 配列に要素が1つ以上あれば真を返します。
extern fn Bool<T>(a: Vec<T>) -> Bool {
    effects: "read_fresh",
    code: "Obj<bool> @{fn}(Obj<@{Vec<T>}> a, Loc) { return make_obj<bool>(!a->empty()); }",
}

/// 末尾の要素を取り除いて返します。空なら実行時エラーです。
extern fn pop_back<T>(a: Vec<T>) -> T {
    return_abi: "object",
    code: "Obj<@{T}> @{fn}(Obj<@{Vec<T>}> a,Loc loc){ if(a->empty()) fail(loc,\"pop from empty array\"); auto value=a->back();a->pop_back();++a->version;return value; }",
}

extern fn __eq__<T>(a: Vec<T>, b: Vec<T>) -> Bool {
    effects: "read_fresh",
    lower: "([&](){auto compare=[&](const auto& left,const auto& right){const auto left_size=left->size();const auto right_size=right->size();if(left_size!=right_size)return false;[[maybe_unused]]const auto left_version=left->version;[[maybe_unused]]const auto right_version=right->version;auto guard=[&](){if constexpr(@{writes __eq__(T,T)->Bool}){if(left->version!=left_version||right->version!=right_version)fail($loc,\"container changed during comparison\");}};for(std::size_t i=0;i<std::min(left_size,right_size);++i){guard();int decision=0;if constexpr(@{writes __eq__(T,T)->Bool}){{auto x=(*left)[i];auto y=(*right)[i];if(!@{value_call __eq__(T,T)->Bool}(x,y,$loc)) decision=-1;guard();}}else{if(!@{value_call __eq__(T,T)->Bool}((*left)[i],(*right)[i],$loc)) decision=-1;guard();}guard();if(decision)return false;}guard();return true;};if constexpr(@{writes __eq__(T,T)->Bool}){auto left=$0;auto right=$1;return compare(left,right);}else return compare($0,$1);}())",
    code: "Obj<bool> @{fn}(Obj<@{Vec<T>}> a,Obj<@{Vec<T>}> b,Loc loc){return make_obj<bool>(([&](){auto compare=[&](const auto& left,const auto& right){const auto left_size=left->size();const auto right_size=right->size();if(left_size!=right_size)return false;[[maybe_unused]]const auto left_version=left->version;[[maybe_unused]]const auto right_version=right->version;auto guard=[&](){if constexpr(@{writes __eq__(T,T)->Bool}){if(left->version!=left_version||right->version!=right_version)fail(loc,\"container changed during comparison\");}};for(std::size_t i=0;i<std::min(left_size,right_size);++i){guard();int decision=0;if constexpr(@{writes __eq__(T,T)->Bool}){{auto x=(*left)[i];auto y=(*right)[i];if(!@{value_call __eq__(T,T)->Bool}(x,y,loc)) decision=-1;guard();}}else{if(!@{value_call __eq__(T,T)->Bool}((*left)[i],(*right)[i],loc)) decision=-1;guard();}guard();if(decision)return false;}guard();return true;};if constexpr(@{writes __eq__(T,T)->Bool}){auto left=a;auto right=b;return compare(left,right);}else return compare(a,b);}()));}",
}

extern fn __ne__<T>(a: Vec<T>, b: Vec<T>) -> Bool {
    effects: "read_fresh",
    lower: "!@{value_call __eq__(Vec<T>,Vec<T>)->Bool}($0,$1,$loc)",
    code: "Obj<bool> @{fn}(Obj<@{Vec<T>}> a,Obj<@{Vec<T>}> b,Loc loc){return make_obj<bool>(!@{value_call __eq__(Vec<T>,Vec<T>)->Bool}(a,b,loc));}",
}

extern fn __lt__<T>(a: Vec<T>, b: Vec<T>) -> Bool {
    effects: "read_fresh",
    lower: "([&](){auto compare=[&](const auto& left,const auto& right){const auto left_size=left->size();const auto right_size=right->size();[[maybe_unused]]const auto left_version=left->version;[[maybe_unused]]const auto right_version=right->version;auto guard=[&](){if constexpr(@{writes sequence_element_less(T,T)->Bool}){if(left->version!=left_version||right->version!=right_version)fail($loc,\"container changed during comparison\");}};for(std::size_t i=0;i<std::min(left_size,right_size);++i){guard();int decision=0;if constexpr(@{writes sequence_element_less(T,T)->Bool}){{auto x=(*left)[i];auto y=(*right)[i];if(@{value_call sequence_element_less(T,T)->Bool}(x,y,$loc)) decision=1;guard();if(!decision){if(@{value_call sequence_element_less(T,T)->Bool}(y,x,$loc)) decision=-1;guard();}}}else{if(@{value_call sequence_element_less(T,T)->Bool}((*left)[i],(*right)[i],$loc)) decision=1;guard();if(!decision){if(@{value_call sequence_element_less(T,T)->Bool}((*right)[i],(*left)[i],$loc)) decision=-1;guard();}}guard();if(decision)return decision>0;}guard();return left_size<right_size;};if constexpr(@{writes sequence_element_less(T,T)->Bool}){auto left=$0;auto right=$1;return compare(left,right);}else return compare($0,$1);}())",
    code: "Obj<bool> @{fn}(Obj<@{Vec<T>}> a,Obj<@{Vec<T>}> b,Loc loc){return make_obj<bool>(([&](){auto compare=[&](const auto& left,const auto& right){const auto left_size=left->size();const auto right_size=right->size();[[maybe_unused]]const auto left_version=left->version;[[maybe_unused]]const auto right_version=right->version;auto guard=[&](){if constexpr(@{writes sequence_element_less(T,T)->Bool}){if(left->version!=left_version||right->version!=right_version)fail(loc,\"container changed during comparison\");}};for(std::size_t i=0;i<std::min(left_size,right_size);++i){guard();int decision=0;if constexpr(@{writes sequence_element_less(T,T)->Bool}){{auto x=(*left)[i];auto y=(*right)[i];if(@{value_call sequence_element_less(T,T)->Bool}(x,y,loc)) decision=1;guard();if(!decision){if(@{value_call sequence_element_less(T,T)->Bool}(y,x,loc)) decision=-1;guard();}}}else{if(@{value_call sequence_element_less(T,T)->Bool}((*left)[i],(*right)[i],loc)) decision=1;guard();if(!decision){if(@{value_call sequence_element_less(T,T)->Bool}((*right)[i],(*left)[i],loc)) decision=-1;guard();}}guard();if(decision)return decision>0;}guard();return left_size<right_size;};if constexpr(@{writes sequence_element_less(T,T)->Bool}){auto left=a;auto right=b;return compare(left,right);}else return compare(a,b);}()));}",
}

extern fn __le__<T>(a: Vec<T>, b: Vec<T>) -> Bool {
    effects: "read_fresh",
    lower: "!@{value_call __lt__(Vec<T>,Vec<T>)->Bool}($1,$0,$loc)",
    code: "Obj<bool> @{fn}(Obj<@{Vec<T>}> a,Obj<@{Vec<T>}> b,Loc loc){return make_obj<bool>(!@{value_call __lt__(Vec<T>,Vec<T>)->Bool}(b,a,loc));}",
}

extern fn __gt__<T>(a: Vec<T>, b: Vec<T>) -> Bool {
    effects: "read_fresh",
    lower: "@{value_call __lt__(Vec<T>,Vec<T>)->Bool}($1,$0,$loc)",
    code: "Obj<bool> @{fn}(Obj<@{Vec<T>}> a,Obj<@{Vec<T>}> b,Loc loc){return make_obj<bool>(@{value_call __lt__(Vec<T>,Vec<T>)->Bool}(b,a,loc));}",
}

extern fn __ge__<T>(a: Vec<T>, b: Vec<T>) -> Bool {
    effects: "read_fresh",
    lower: "!@{value_call __lt__(Vec<T>,Vec<T>)->Bool}($0,$1,$loc)",
    code: "Obj<bool> @{fn}(Obj<@{Vec<T>}> a,Obj<@{Vec<T>}> b,Loc loc){return make_obj<bool>(!@{value_call __lt__(Vec<T>,Vec<T>)->Bool}(a,b,loc));}",
}

extern fn __cmp__<T>(a: Vec<T>, b: Vec<T>) -> Ordering {
    effects: "checked_read_fresh",
    code: "Obj<@{Ordering}> @{fn}(Obj<@{Vec<T>}> a, Obj<@{Vec<T>}> b, Loc loc) { const auto av = a->version, bv = b->version; auto guard = [&]() { if constexpr (@{writes __cmp__(T,T)->Ordering}) { if (a->version != av || b->version != bv) fail(loc,\"container changed during comparison\"); } }; for (std::size_t i = 0, n = std::min(a->size(),b->size()); i < n; ++i) { guard(); { auto left = (*a)[i]; auto right = (*b)[i]; auto order = @{call __cmp__(T,T)->Ordering}(left,right,loc); guard(); if (rusk_enum_index<@{Ordering}>(order->value) != 1) return order; } guard(); } if (a->size() < b->size()) return rusk_enum_make<@{Ordering},0>(); if (a->size() > b->size()) return rusk_enum_make<@{Ordering},2>(); return rusk_enum_make<@{Ordering},1>(); }",
}

/// 昇順の配列で、値より小さくない最初の要素の位置を返します。該当しなければ配列の長さです。
extern fn bisect_left<T>(a: Vec<T>, x: T) -> Int {
    code: "Obj<std::int64_t> @{fn}(Obj<@{Vec<T>}> a,Obj<@{T}> x,Loc loc){const auto version=a->version;auto guard=[&](){if(a->version!=version)fail(loc,\"container changed during comparison\");};auto compare=[&](const auto& left,const auto& right){if constexpr(@{writes sequence_element_less(T,T)->Bool}){guard();bool result;{auto l=left;auto r=right;result=@{value_call sequence_element_less(T,T)->Bool}(l,r,loc);guard();}guard();return result;}else return @{value_call sequence_element_less(T,T)->Bool}(left,right,loc);};auto it=std::lower_bound(a->begin(),a->end(),x,compare);if constexpr(@{writes sequence_element_less(T,T)->Bool}){guard();}return make_obj<std::int64_t>(it-a->begin());}",
}

/// 昇順の配列で、値より大きい最初の要素の位置を返します。該当しなければ配列の長さです。
extern fn bisect_right<T>(a: Vec<T>, x: T) -> Int {
    code: "Obj<std::int64_t> @{fn}(Obj<@{Vec<T>}> a,Obj<@{T}> x,Loc loc){const auto version=a->version;auto guard=[&](){if(a->version!=version)fail(loc,\"container changed during comparison\");};auto compare=[&](const auto& left,const auto& right){if constexpr(@{writes sequence_element_less(T,T)->Bool}){guard();bool result;{auto l=left;auto r=right;result=@{value_call sequence_element_less(T,T)->Bool}(l,r,loc);guard();}guard();return result;}else return @{value_call sequence_element_less(T,T)->Bool}(left,right,loc);};auto it=std::upper_bound(a->begin(),a->end(),x,compare);if constexpr(@{writes sequence_element_less(T,T)->Bool}){guard();}return make_obj<std::int64_t>(it-a->begin());}",
}

/// 値と等しい要素が配列に含まれるか調べます。
extern fn contains<T>(a: Vec<T>, x: T) -> Bool {
    code: "Obj<bool> @{fn}(Obj<@{Vec<T>}> a,Obj<@{T}> x,Loc loc){if constexpr(@{writes __eq__(T,T)->Bool}){const auto version=a->version;auto guard=[&](){if(a->version!=version)fail(loc,\"container changed during comparison\");};for(std::size_t i=0,n=a->size();i<n;++i){guard();bool found;{auto value=(*a)[i];found=@{value_call __eq__(T,T)->Bool}(value,x,loc);guard();}guard();if(found)return make_obj<bool>(true);}guard();return make_obj<bool>(false);}else{return make_obj<bool>(std::any_of(a->begin(),a->end(),[&](const auto& value){return @{value_call __eq__(T,T)->Bool}(value,x,loc);}));}}",
}

/// 配列を要素の全順序 `<=>` でその場で安定ソートします。
extern fn sort<T>(a: Vec<T>) {
    code: "void @{fn}(Obj<@{Vec<T>}> a,Loc loc){if constexpr(!@{writes __total_less__<T>(T,T)->Bool}&&!@{fails __total_less__<T>(T,T)->Bool}){std::stable_sort(a->begin(),a->end(),[](const auto& x,const auto& y){return @{value_call __total_less__<T>(T,T)->Bool}(x,y,Loc{});});}else if constexpr(!@{writes __total_less__<T>(T,T)->Bool}){std::stable_sort(a->begin(),a->end(),[&](const auto& x,const auto& y){return @{value_call __total_less__<T>(T,T)->Bool}(x,y,loc);});}else{const auto version=a->version;auto guard=[&](){if(a->version!=version)fail(loc,\"container changed during comparison\");};auto values=*a;std::stable_sort(values.begin(),values.end(),[&](const auto& x,const auto& y){guard();bool result;{auto left=x;auto right=y;result=@{value_call __total_less__<T>(T,T)->Bool}(left,right,loc);guard();}guard();return result;});guard();auto displaced=*a;a->assign(values.begin(),values.end());++a->version;const auto committed=a->version;displaced.clear();if(a->version!=committed)fail(loc,\"container changed during comparison\");values.clear();if(a->version!=committed)fail(loc,\"container changed during comparison\");return;}++a->version;}",
}

/// 元の要素を共有する新しい配列を、要素の全順序 `<=>` で安定ソートして返します。
extern fn sorted<T>(a: Vec<T>) -> Vec<T> {
    code: "Obj<@{Vec<T>}> @{fn}(Obj<@{Vec<T>}> a,Loc loc){auto result=make_obj<@{Vec<T>}>(*a);if constexpr(!@{writes __total_less__<T>(T,T)->Bool}&&!@{fails __total_less__<T>(T,T)->Bool}){std::stable_sort(result->begin(),result->end(),[](const auto& x,const auto& y){return @{value_call __total_less__<T>(T,T)->Bool}(x,y,Loc{});});}else if constexpr(!@{writes __total_less__<T>(T,T)->Bool}){std::stable_sort(result->begin(),result->end(),[&](const auto& x,const auto& y){return @{value_call __total_less__<T>(T,T)->Bool}(x,y,loc);});}else{const auto version=a->version;auto guard=[&](){if(a->version!=version)fail(loc,\"container changed during comparison\");};std::stable_sort(result->begin(),result->end(),[&](const auto& x,const auto& y){guard();bool result;{auto left=x;auto right=y;result=@{value_call __total_less__<T>(T,T)->Bool}(left,right,loc);guard();}guard();return result;});guard();}return result;}",
}
