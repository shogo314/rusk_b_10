// Conditions and value comparisons.
extern fn __bool__(x: Int) -> Bool {
    lower: "(*$0 != 0)",
    effects: "read_fresh",
    cpp_name: "bool_Int",
    code: "inline Obj<bool> bool_Int(Obj<std::int64_t> x, Loc) { return make_obj<bool>(*x != 0); }",
}

extern fn __eq__(a: Int, b: Int) -> Bool {
    lower: "(*$0 == *$1)",
    effects: "read_fresh",
    cpp_name: "eq_Int",
    code: "inline Obj<bool> eq_Int(Obj<std::int64_t> a, Obj<std::int64_t> b, Loc) { return make_obj<bool>(*a == *b); }",
}

extern fn __ne__(a: Int, b: Int) -> Bool {
    lower: "(*$0 != *$1)",
