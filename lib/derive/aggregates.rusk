extern fn product_equal_body<T>(a: T, b: T) -> Bool {
    derive: "tuple_eq",
    effects: "read_fresh",
    lower: "([&](){auto compare=[&](const auto& left,const auto& right){@{fields T as F,I}{bool equal;if constexpr(@{writes __eq__(F,F)->Bool}){{auto x=left->field_@{index I};auto y=right->field_@{index I};equal=@{value_call __eq__(F,F)->Bool}(x,y,$loc);}}else{equal=@{value_call __eq__(F,F)->Bool}(left->field_@{index I},right->field_@{index I},$loc);}if(!equal)return false;}@{end}return true;};if constexpr(@{writes __eq__(T,T)->Bool}){auto left=$0;auto right=$1;return compare(left,right);}else return compare($0,$1);}())",
    code: "Obj<bool> @{fn}(Obj<@{T}> a,Obj<@{T}> b,Loc loc){return make_obj<bool>(([&](){auto& left=a;auto& right=b;@{fields T as F,I}{bool equal;if constexpr(@{writes __eq__(F,F)->Bool}){{auto x=left->field_@{index I};auto y=right->field_@{index I};equal=@{value_call __eq__(F,F)->Bool}(x,y,loc);}}else{equal=@{value_call __eq__(F,F)->Bool}(left->field_@{index I},right->field_@{index I},loc);}if(!equal)return false;}@{end}return true;}()));}",
}

extern fn product_less_body<T>(a: T, b: T) -> Bool {
    derive: "tuple_lt",
    effects: "read_fresh",
    lower: "([&](){auto compare=[&](const auto& left,const auto& right){@{fields T as F,I}{int decision=0;if constexpr(@{writes sequence_element_less(F,F)->Bool}){{auto x=left->field_@{index I};auto y=right->field_@{index I};if(@{value_call sequence_element_less(F,F)->Bool}(x,y,$loc))decision=1;else if(@{value_call sequence_element_less(F,F)->Bool}(y,x,$loc))decision=-1;}}else{if(@{value_call sequence_element_less(F,F)->Bool}(left->field_@{index I},right->field_@{index I},$loc))decision=1;else if(@{value_call sequence_element_less(F,F)->Bool}(right->field_@{index I},left->field_@{index I},$loc))decision=-1;}if(decision)return decision>0;}@{end}return false;};if constexpr(@{writes __lt__(T,T)->Bool}){auto left=$0;auto right=$1;return compare(left,right);}else return compare($0,$1);}())",
    code: "Obj<bool> @{fn}(Obj<@{T}> a,Obj<@{T}> b,Loc loc){return make_obj<bool>(([&](){auto& left=a;auto& right=b;@{fields T as F,I}{int decision=0;if constexpr(@{writes sequence_element_less(F,F)->Bool}){{auto x=left->field_@{index I};auto y=right->field_@{index I};if(@{value_call sequence_element_less(F,F)->Bool}(x,y,loc))decision=1;else if(@{value_call sequence_element_less(F,F)->Bool}(y,x,loc))decision=-1;}}else{if(@{value_call sequence_element_less(F,F)->Bool}(left->field_@{index I},right->field_@{index I},loc))decision=1;else if(@{value_call sequence_element_less(F,F)->Bool}(right->field_@{index I},left->field_@{index I},loc))decision=-1;}if(decision)return decision>0;}@{end}return false;}()));}",
}

extern fn product_not_equal_body<T>(a: T, b: T) -> Bool {
    derive: "tuple_ne",
    effects: "read_fresh",
    lower: "!@{value_call __eq__(T,T)->Bool}($0,$1,$loc)",
    code: "Obj<bool> @{fn}(Obj<@{T}> a,Obj<@{T}> b,Loc loc){return make_obj<bool>(!@{value_call __eq__(T,T)->Bool}(a,b,loc));}",
}

extern fn product_less_equal_body<T>(a: T, b: T) -> Bool {
    derive: "tuple_le",
    effects: "read_fresh",
    lower: "!@{value_call __lt__(T,T)->Bool}($1,$0,$loc)",
    code: "Obj<bool> @{fn}(Obj<@{T}> a,Obj<@{T}> b,Loc loc){return make_obj<bool>(!@{value_call __lt__(T,T)->Bool}(b,a,loc));}",
}

extern fn product_greater_body<T>(a: T, b: T) -> Bool {
    derive: "tuple_gt",
    effects: "read_fresh",
    lower: "@{value_call __lt__(T,T)->Bool}($1,$0,$loc)",
    code: "Obj<bool> @{fn}(Obj<@{T}> a,Obj<@{T}> b,Loc loc){return make_obj<bool>(@{value_call __lt__(T,T)->Bool}(b,a,loc));}",
}

extern fn product_greater_equal_body<T>(a: T, b: T) -> Bool {
    derive: "tuple_ge",
    effects: "read_fresh",
    lower: "!@{value_call __lt__(T,T)->Bool}($0,$1,$loc)",
    code: "Obj<bool> @{fn}(Obj<@{T}> a,Obj<@{T}> b,Loc loc){return make_obj<bool>(!@{value_call __lt__(T,T)->Bool}(a,b,loc));}",
}

// Tuple output resolves each field's logical writer through the common ABI.
extern fn product_write_body<T>(value: T) -> Unit {
    derive: "tuple_write",
    effects: "checked_io_write",
    lower: "([&](){auto emit=[&](const auto& value){@{fields T as F,I}if constexpr(@{index I}>0)rusk_write(' ');if constexpr(@{writes __write__(F)->Unit}){auto field=value->field_@{index I};@{value_call __write__(F)->Unit}(field,$loc);}else{@{value_call __write__(F)->Unit}(value->field_@{index I},$loc);}@{end}};if constexpr(@{writes __write__(T)->Unit}){auto owner=$0;emit(owner);}else emit($0);}())",
    code: "void @{fn}(Obj<@{T}> value,Loc loc){@{fields T as F,I}if constexpr(@{index I}>0)rusk_write(' ');if constexpr(@{writes __write__(F)->Unit}){auto field=value->field_@{index I};@{value_call __write__(F)->Unit}(field,loc);}else{@{value_call __write__(F)->Unit}(value->field_@{index I},loc);}@{end}}",
}

// Preserve the fixed argument ABI when deriving multidimensional input.
extern fn dimensions_read_body<T>() -> Vec<T> {
    derive: "vector_read",
    code: "Obj<@{Vec<T>}> @{fn}(@{arguments as P,I}Obj<@{P}> d@{index I},@{end}Loc loc){@{arguments as P,I}if(*d@{index I}<0)fail(loc,\"negative array length\");@{end}auto n=*d0;auto result=make_obj<@{Vec<T>}>(@{Vec<T>}{ });if(static_cast<__int128>(n)>result->max_size())fail(loc,\"array length out of range\");result->reserve(static_cast<std::size_t>(n));for(std::int64_t i=0;i<n;++i)result->push_back(@{boxed_call __read__(...arguments 1)->T}(@{arguments from 1 as P,I}d@{index I},@{end}loc));return result;}",
}

// Language-generated record/Tuple/capture copies use this source template.
// The derive role registers automatic operations; the function name is arbitrary.
extern fn aggregate_copy_body<T>(value: T) -> T {
    derive: "record_copy",
    code: "Obj<@{T}> @{fn}(const Obj<@{T}>& value,Loc loc){return make_obj<@{T}>(@{T}{@{fields T as F,I}@{boxed_call copy(F)->F}(value->field_@{index I},loc),@{end}});}",
}

extern fn sum_copy_body<T>(value: T) -> T {
    derive: "enum_copy",
    code: "Obj<@{T}> @{fn}(const Obj<@{T}>& value,[[maybe_unused]] Loc loc){auto snapshot=value->value;switch(rusk_enum_index<@{T}>(snapshot)){@{variants T as V}case @{index V}:{@{fields T variant V as F,I}auto field_@{index I}=@{boxed_call copy(F)->F}(rusk_enum_payload<@{T},@{index V}>(snapshot).field_@{index I},loc);@{end}return std::apply([](auto&&... fields){return rusk_enum_make<@{T},@{index V}>(std::move(fields)...);},std::tuple{@{fields T variant V as F,I}std::move(field_@{index I}),@{end}});}@{end}default:fail(loc,\"invalid enum tag\");}}",
}

extern fn aggregate_assign_body<T>(target: T, source: T) -> Unit {
    derive: "record_assign",
    code: "void @{fn}(Obj<@{T}> target,Obj<@{T}> source,Loc loc){auto snapshot=@{rooted_call copy(T)->T}(source,loc);*target=std::move(*snapshot);}",
}
extern fn sum_assign_body<T>(target: T, source: T) -> Unit {
    derive: "enum_assign",
    code: "void @{fn}(Obj<@{T}> target,Obj<@{T}> source,Loc loc){auto snapshot=@{rooted_call copy(T)->T}(source,loc);target->value=std::move(snapshot->value);}",
}

extern fn product_read_body<T>() -> T {
    derive: "tuple_read",
    code: "Obj<@{T}> @{fn}(Loc loc){@{fields T as F,I}auto value_@{index I}=@{boxed_call __read__()->F}(loc);@{end}return make_obj<@{T}>(@{T}{@{fields T as F,I}value_@{index I},@{end}});}",
}
