//! 走査とコールバックを合成する遅延イテレータです。

// Lazy state and operations use ordinary type, callable, and ABI references.

/// 走査元と変換関数を保持し、走査時に変換結果を返します。
extern type<I, F, T, R> Mapped {
    cpp_name: "RuskLazyIterator<{I},{F},{R},false>",
    representation: "iterator<R>",
    retains: "source:I;callback:F;cached:R",
}

/// 要素を取り出すたびに変換関数を呼ぶ遅延イテレータを作ります。
extern fn map<S, F, I, T, R>(source: S, callback: F) -> Mapped<I, F, T, R> {
    code: "Obj<@{Mapped<I,F,T,R>}> @{fn}(Obj<@{S}> source,Obj<@{F}> callback,Loc loc){using Result [[maybe_unused]]=@{nonunit R};[[maybe_unused]]auto has=@{boxed_call __iter_has_next__(I)->Bool};[[maybe_unused]]auto next=@{boxed_call __iter_next__(I)->T};[[maybe_unused]]auto invoke=@{boxed_invoke F(T)->R};return make_obj<@{Mapped<I,F,T,R>}>(@{Mapped<I,F,T,R>}{@{boxed_call __iter__(S)->I}(source,loc),callback,{},false,false});}",
}

extern fn __iter__<I, F, T, R>(it: Mapped<I, F, T, R>) -> Mapped<I, F, T, R> {
    effects: "read_fresh",
    aliases: "return=0",
    code: "Obj<@{Mapped<I,F,T,R>}> @{fn}(Obj<@{Mapped<I,F,T,R>}> it,[[maybe_unused]] Loc loc){return it;}",
}

extern fn __iter_has_next__<I, F, T, R>(it: Mapped<I, F, T, R>) -> Bool {
    code: "Obj<@{Bool}> @{fn}(Obj<@{Mapped<I,F,T,R>}> it,Loc loc){if(it->finished)return make_obj<@{Bool}>(false);bool result=*@{boxed_call __iter_has_next__(I)->Bool}(it->source,loc);if(!result)it->finished=true;return make_obj<@{Bool}>(result);}",
}

extern fn __iter_next__<I, F, T, R>(it: Mapped<I, F, T, R>) -> R {
    return_abi: "object",
    code: "Obj<@{nonunit R}> @{fn}(Obj<@{Mapped<I,F,T,R>}> it,Loc loc){if(!*@{boxed_call __iter_has_next__(Mapped<I,F,T,R>)->Bool}(it,loc))fail(loc,\"iterator exhausted\");auto value=@{boxed_call __iter_next__(I)->T}(it->source,loc);auto result=@{boxed_invoke F(T)->R}(it->callback,value,loc);rusk_guard_iter(it->source,loc);return result;}",
}

/// 走査状態・コールバック・キャッシュ済みの値を各型の `copy` でコピーします。
extern fn copy<I, F, T, R>(it: Mapped<I, F, T, R>) -> Mapped<I, F, T, R> {
    effects: "read_fresh",
    lower_owned: "([&](){auto clone=[&](const auto& it){return make_obj<@{Mapped<I,F,T,R>}>(@{Mapped<I,F,T,R>}{@{owned_call copy(I)->I via (0.source) into return.source}(it->source,$loc),@{boxed_call copy(F)->F via (0.callback) into return.callback}(it->callback,$loc),it->cached?@{boxed_call copy(R)->R via (0.cached) into return.cached}(it->cached,$loc):Obj<@{R}>{},it->ready,it->finished});};if constexpr(@{writes copy(I)->I}||@{writes copy(F)->F}||@{writes copy(R)->R}){auto owner=$0;return clone(owner);}else return clone($0);}())",
    lower_rooted: "([&](){auto& it=$0;return make_obj<@{Mapped<I,F,T,R>}>(@{Mapped<I,F,T,R>}{@{owned_call copy(I)->I via (0.source) into return.source}(it->source,$loc),@{boxed_call copy(F)->F via (0.callback) into return.callback}(it->callback,$loc),it->cached?@{boxed_call copy(R)->R via (0.cached) into return.cached}(it->cached,$loc):Obj<@{R}>{},it->ready,it->finished});}())",
    code: "Obj<@{Mapped<I,F,T,R>}> @{fn}(Obj<@{Mapped<I,F,T,R>}> it,Loc loc){return make_obj<@{Mapped<I,F,T,R>}>(@{Mapped<I,F,T,R>}{@{owned_call copy(I)->I via (0.source) into return.source}(it->source,loc),@{boxed_call copy(F)->F via (0.callback) into return.callback}(it->callback,loc),it->cached?@{boxed_call copy(R)->R via (0.cached) into return.cached}(it->cached,loc):Obj<@{R}>{},it->ready,it->finished});}",
}

extern fn __assign__<I, F, T, R>(target: Mapped<I, F, T, R>, source: Mapped<I, F, T, R>) -> Unit {
    effects: "checked_resize_first",
    code: "void @{fn}(Obj<@{Mapped<I,F,T,R>}> target,Obj<@{Mapped<I,F,T,R>}> source,Loc loc){auto snapshot=@{rooted_call copy(Mapped<I,F,T,R>)->Mapped<I,F,T,R> via (1) into 0}(source,loc);*target=std::move(*snapshot);}",
}

/// 走査元と述語を保持し、述語を満たした要素を返します。
extern type<I, F, T> Filtered {
    cpp_name: "RuskLazyIterator<{I},{F},{T},true>",
    representation: "iterator<T>",
    retains: "source:I;callback:F;cached:T",
}

/// 述語を満たす要素だけを走査順に返す遅延イテレータを作ります。
extern fn filter<S, F, I, T>(source: S, callback: F) -> Filtered<I, F, T> {
    code: "Obj<@{Filtered<I,F,T>}> @{fn}(Obj<@{S}> source,Obj<@{F}> callback,Loc loc){using Result [[maybe_unused]]=@{nonunit T};[[maybe_unused]]auto has=@{boxed_call __iter_has_next__(I)->Bool};[[maybe_unused]]auto next=@{boxed_call __iter_next__(I)->T};[[maybe_unused]]auto invoke=@{boxed_invoke F(T)->Bool};return make_obj<@{Filtered<I,F,T>}>(@{Filtered<I,F,T>}{@{boxed_call __iter__(S)->I}(source,loc),callback,{},false,false});}",
}

extern fn __iter__<I, F, T>(it: Filtered<I, F, T>) -> Filtered<I, F, T> {
    effects: "read_fresh",
    aliases: "return=0",
    code: "Obj<@{Filtered<I,F,T>}> @{fn}(Obj<@{Filtered<I,F,T>}> it,[[maybe_unused]] Loc loc){return it;}",
}

extern fn __iter_has_next__<I, F, T>(it: Filtered<I, F, T>) -> Bool {
    code: "Obj<@{Bool}> @{fn}(Obj<@{Filtered<I,F,T>}> it,Loc loc){if(it->finished)return make_obj<@{Bool}>(false);rusk_guard_iter(it->source,loc);if(it->ready)return make_obj<@{Bool}>(true);while(*@{boxed_call __iter_has_next__(I)->Bool}(it->source,loc)){auto value=@{boxed_call __iter_next__(I)->T}(it->source,loc);auto accepted=@{boxed_invoke F(T)->Bool}(it->callback,value,loc);rusk_guard_iter(it->source,loc);if(*accepted){it->cached=value;it->ready=true;return make_obj<@{Bool}>(true);}}it->finished=true;return make_obj<@{Bool}>(false);}",
}

extern fn __iter_next__<I, F, T>(it: Filtered<I, F, T>) -> T {
    return_abi: "object",
    code: "Obj<@{nonunit T}> @{fn}(Obj<@{Filtered<I,F,T>}> it,Loc loc){if(!*@{boxed_call __iter_has_next__(Filtered<I,F,T>)->Bool}(it,loc))fail(loc,\"iterator exhausted\");auto value=it->cached;it->cached.reset();it->ready=false;return value;}",
}

/// 走査状態・述語・キャッシュ済みの値を各型の `copy` でコピーします。
extern fn copy<I, F, T>(it: Filtered<I, F, T>) -> Filtered<I, F, T> {
    effects: "read_fresh",
    lower_owned: "([&](){auto clone=[&](const auto& it){return make_obj<@{Filtered<I,F,T>}>(@{Filtered<I,F,T>}{@{owned_call copy(I)->I via (0.source) into return.source}(it->source,$loc),@{boxed_call copy(F)->F via (0.callback) into return.callback}(it->callback,$loc),it->cached?@{boxed_call copy(T)->T via (0.cached) into return.cached}(it->cached,$loc):Obj<@{T}>{},it->ready,it->finished});};if constexpr(@{writes copy(I)->I}||@{writes copy(F)->F}||@{writes copy(T)->T}){auto owner=$0;return clone(owner);}else return clone($0);}())",
    lower_rooted: "([&](){auto& it=$0;return make_obj<@{Filtered<I,F,T>}>(@{Filtered<I,F,T>}{@{owned_call copy(I)->I via (0.source) into return.source}(it->source,$loc),@{boxed_call copy(F)->F via (0.callback) into return.callback}(it->callback,$loc),it->cached?@{boxed_call copy(T)->T via (0.cached) into return.cached}(it->cached,$loc):Obj<@{T}>{},it->ready,it->finished});}())",
    code: "Obj<@{Filtered<I,F,T>}> @{fn}(Obj<@{Filtered<I,F,T>}> it,Loc loc){return make_obj<@{Filtered<I,F,T>}>(@{Filtered<I,F,T>}{@{owned_call copy(I)->I via (0.source) into return.source}(it->source,loc),@{boxed_call copy(F)->F via (0.callback) into return.callback}(it->callback,loc),it->cached?@{boxed_call copy(T)->T via (0.cached) into return.cached}(it->cached,loc):Obj<@{T}>{},it->ready,it->finished});}",
}

extern fn __assign__<I, F, T>(target: Filtered<I, F, T>, source: Filtered<I, F, T>) -> Unit {
    effects: "checked_resize_first",
    code: "void @{fn}(Obj<@{Filtered<I,F,T>}> target,Obj<@{Filtered<I,F,T>}> source,Loc loc){auto snapshot=@{rooted_call copy(Filtered<I,F,T>)->Filtered<I,F,T> via (1) into 0}(source,loc);*target=std::move(*snapshot);}",
}
