%start Rusk
%title "Rusk beta prototype"
%line_comment "//"
%%
Rusk: { Statement };
Statement: SimpleStatement | BlockStatement | StatementExpr ';'^;
BlockStatement: Block [ ';' ];
SimpleStatement: Include | EnumDef | MatchStatement | StructDef | Function | Return | ExternType | ExternFn | ExternSymbol | Let | Input | Output | If | For | While | Loop | Break | Continue | LabeledLoop;
LabeledLoop: LoopLabel LoopStatement;
LoopLabel: /[a-zA-Z_][a-zA-Z0-9_]*(?:[ \t\r\n]|\/\/[^\r\n]*[\r\n])*:/ ?= /(?:[ \t\r\n]|\/\/[^\r\n]*[\r\n])*(?:for|while|loop)[^a-zA-Z0-9_]/;
LoopStatement: For | While | Loop;
Include: 'include'^ StringLiteral ';'^;
EnumDef: 'enum'^ Identifier [ TypeParameters ] '{'^ [ EnumVariants ] '}'^;
EnumVariants: EnumVariant { ','^ EnumVariant } [ ','^ ];
EnumVariant: Identifier [ '('^ VariantTypes ')'^ ];
VariantTypes: TypeName { ','^ TypeName };
MatchStatement: MatchExpr [ ';' ];
MatchExpr: 'match' Expr '{'^ { MatchArm } '}'^;
MatchArm: Pattern [ Guard ] '=>'^ ArmBody;
Guard: 'if'^ Expr;
Pattern: PatternAtom { '|'^ PatternAtom };
PatternAtom: NamedPattern | Literal | NegativePattern | ParenPattern;
NegativePattern: '-'^ NumberLiteral;
NamedPattern: Reference [ NamedPatternTail ];
NamedPatternTail: '('^ [ PatternList ] ')'^ | PatternRecord;
PatternList: Pattern { ','^ Pattern } [ ','^ ];
ParenPattern: '(' [ Pattern ParenPatternTail ] ')'^;
ParenPatternTail: ',' Pattern { ','^ Pattern } [ ','^ ] | ;
PatternRecord: '{'^ [ PatternFields ] '}'^;
PatternFields: PatternField { ','^ PatternField } [ ','^ ];
PatternField: Identifier [ ':'^ Pattern ] | '..';
ArmBody: Block [ ','^ ] | StatementExpr ','^ | IfExpr ','^ | MatchExpr ','^;
StructDef: 'struct'^ Identifier [ TypeParameters ] '{'^ { StructField } '}'^;
StructField: Identifier ':'^ TypeName ';'^;
Function: 'fn'^ Identifier [ TypeParameters ] '('^ Parameters ')'^ [ '->'^ TypeName ] Block;
TypeParameters: '<'^ Identifier { ','^ Identifier } '>'^;
Return: 'return' [ Expr ] ';'^;
ExternType: 'extern'^ 'type'^ [ TypeParameters ] TypeName '{'^ Properties '}'^;
ExternFn: 'extern'^ 'fn'^ Identifier [ TypeParameters ] '('^ Parameters ')'^ [ '->'^ TypeName ] '{'^ Properties '}'^;
ExternSymbol: 'extern'^ 'symbol'^ Identifier '{'^ Properties '}'^;
Parameters: [ Parameter { ','^ Parameter } ];
Parameter: BindingModifiers Identifier ':'^ TypeName;
BindingModifiers: { BindingModifier };
BindingModifier: 'fixed' | 'rebindable' | 'readonly' | 'mutable' | 'noescape' | 'escape';
TypeName: NamedType | TupleType;
NamedType: Identifier [ TypeArguments ];
TypeArguments: '<'^ TypeName { ','^ TypeName } '>'^;
TupleType: '('^ TypeName ','^ TypeName { ','^ TypeName } ')'^;
Properties: { Property };
Property: Identifier ':'^ StringLiteral ','^;
Let: BindingModifiers 'let'^ Binding [ ':'^ TypeName ] [ LetInitOp Expr ] ';'^;
Binding: Identifier | '(' Binding ','^ Binding { ','^ Binding } ')'^;
LetInitOp: ':=' | '=';
Input: 'in'^ InputItem { ','^ InputItem } ';'^;
InputItem: InputName { ','^ InputName } ':'^ TypeName;
InputName: Identifier [ '('^ ExprList ')'^ ];
Output: 'wt'^ ExprList ';'^;
Block: '{' BlockItems '}'^;
BlockItems: SimpleStatement BlockItems | BlockStatement BlockItems | StatementExpr BlockTail | ;
BlockTail: ';'^ BlockItems | ;
ExprList: [ Expr { ','^ Expr } ];
If: 'if' Condition Block [ 'else'^ Block ] [ ';' ];
Condition: LetCondition | Expr;
LetCondition: 'let'^ Pattern '='^ Expr;
For: 'for'^ Binding 'in'^ Expr Block [ 'else'^ Block ];
While: 'while'^ Condition Block [ 'else'^ Block ];
Loop: 'loop'^ Block;
Break: 'break' [ Identifier ] ';'^;
Continue: 'continue' [ Identifier ] ';'^;
Expr: MatchExpr | IfExpr | PlainExpr;
PlainExpr: Lambda | Binary [ AssignOp Expr ];
IfExpr: 'if' Condition Block 'else'^ Block;
StatementExpr: Lambda | StatementBinary [ AssignOp Expr ];
StatementBinary: StatementUnary { BinaryOp Unary };
StatementUnary: UnaryOp Unary | StatementPower;
StatementPower: StatementPostfix [ PowerTail ];
StatementPostfix: NonBlockPrimary { Suffix };
Binary: Unary { BinaryOp Unary };
BinaryOp: '??' | '..' | '||' | '&&' | '|' | '^' | '&' | '==' | '!=' | LeftAngleOp | '<=' | RightAngleOp | '>=' | '<=>' | '<?' | '>?' | '+' | '-' | '*' | '/' | '%';
LeftAngleOp: '<' [ '<' ];
RightAngleOp: '>' [ '>' ];
AssignOp: ':=' | '=' | '+=' | '-=' | '*=' | '/=' | '%=' | '<?=' | '>?=';
Unary: UnaryOp Unary | Power;
Power: Postfix [ PowerTail ];
PowerTail: '**' Unary;
Postfix: Primary { Suffix };
Suffix: Index | Member | Invoke | Unwrap;
Unwrap: '?!';
Invoke: '('^ ExprList ')'^;
Member: '.'^ Identifier;
Index: '[' Expr ']'^;
UnaryOp: '+' | '-' | '!' | '~';
Array: '[' [ Expr ArrayTail ] ']'^;
ArrayTail: ';'^ Expr | { ','^ Expr };
Primary: Block | NonBlockPrimary;
NonBlockPrimary: Array | Literal | Reference [ RecordFields ] | '(' Expr [ TupleTail ] ')'^;
Lambda: '(' Parameters ')'^ '=>'^ Expr;
Reference: Identifier [ '::'^ TypeArguments ] { '::'^ Identifier };
TupleTail: ','^ Expr { ','^ Expr } [ ','^ ];
RecordFields: '{'^ FieldValue { ','^ FieldValue } [ ','^ ] '}'^;
FieldValue: Identifier ':'^ Expr;
Literal: NumberLiteral | StringLiteral | CharLiteral | BoolLiteral;
NumberLiteral: FloatLiteral | Int128Literal | IntLiteral;
BoolLiteral: 'true' | 'false';
IntLiteral: /[0-9]+/;
Int128Literal: /[0-9]+i128/;
FloatLiteral: /(?:[0-9]+\.[0-9]+(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+)/;
StringLiteral: /"(\\.|[^"\\])*"/;
CharLiteral: /'(\\.|[^'\\])'/;
Identifier: /[a-zA-Z_][a-zA-Z0-9_]*/;
